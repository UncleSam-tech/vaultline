{
  "name": "vaultline-mcp-server",
  "version": "0.1.0",
  "description": "Local-first, app-agnostic knowledge-base MCP server. One index over all your notes, cited passages for any agent, nothing leaves your machine.",
  "type": "module",
  "engines": { "node": ">=18" },
  "bin": { "vaultline": "dist/index.js" },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.1",
    "better-sqlite3": "^11.3.0",
    "chokidar": "^3.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.2",
    "tsx": "^4.15.1",
    "typescript": "^5.4.5",
    "vitest": "^2.0.0"
  }
}
